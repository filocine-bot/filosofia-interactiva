<script>
(function(){
  "use strict";

  /* ---------- Datos del reto ---------- */
  const DIM_LABELS = { que:"Qué", como:"Cómo", paraque:"Para qué", familia:"Familia" };
  const CARDS = [
    { text:"Entrenamiento militar y disciplina física extrema desde niños.", dim:"que", city:"esparta" },
    { text:"Gramática, música y gimnasia como base de la formación.", dim:"que", city:"atenas" },
    { text:"Retórica, oratoria y derecho para la vida pública.", dim:"que", city:"roma" },
    { text:"Filosofía y geometría para ejercitar la razón.", dim:"que", city:"atenas" },
    { text:"El agogé: el Estado toma al niño desde los 7 años y lo educa colectivamente.", dim:"como", city:"esparta" },
    { text:"Un esclavo llamado paidagogos acompaña al niño a la escuela y vigila su conducta.", dim:"como", city:"atenas" },
    { text:"Se aprende imitando a grandes oradores y practicando discursos en público.", dim:"como", city:"roma" },
    { text:"La educación es pública, colectiva y controlada directamente por el Estado.", dim:"como", city:"esparta" },
    { text:"Formar guerreros fuertes y obedientes al servicio absoluto del Estado.", dim:"paraque", city:"esparta" },
    { text:"Formar ciudadanos libres, capaces de pensar y decidir por sí mismos.", dim:"paraque", city:"atenas" },
    { text:"Formar oradores y hombres públicos que puedan hablar en el foro y el senado.", dim:"paraque", city:"roma" },
    { text:"Preparar al hombre para el cursus honorum, la carrera de cargos públicos.", dim:"paraque", city:"roma" },
    { text:"El niño pertenece primero al Estado; la autoridad de la familia queda en segundo plano.", dim:"familia", city:"esparta" },
    { text:"El padre elige y paga al pedagogo que acompañará y vigilará a su hijo.", dim:"familia", city:"atenas" },
    { text:"El paterfamilias tiene autoridad absoluta sobre todos los miembros de la casa.", dim:"familia", city:"roma" },
    { text:"La familia es la primera escuela: madre y padre enseñan las primeras letras y valores en casa.", dim:"familia", city:"roma" },
  ];
  const GAME_SECONDS = 300;

  /* ---------- Utilidades ---------- */
  function shuffle(arr){ const a=arr.slice(); for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; }
  function $(id){ return document.getElementById(id); }
  function showScreen(id){
    document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));
    $(id).classList.add("active");
  }

  /* ---------- Sonido (Web Audio API) ---------- */
  let audioCtx = null;
  let soundOn = true;
  function ensureCtx(){ if(!audioCtx){ audioCtx = new (window.AudioContext||window.webkitAudioContext)(); } return audioCtx; }
  function beep(freq, dur, type){
    if(!soundOn) return;
    try{
      const ctx = ensureCtx();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = type || "sine";
      osc.frequency.value = freq;
      gain.gain.setValueAtTime(0.0001, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.18, ctx.currentTime + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + dur);
      osc.connect(gain); gain.connect(ctx.destination);
      osc.start(); osc.stop(ctx.currentTime + dur + 0.02);
    }catch(e){}
  }
  function sfxGood(){ beep(660,0.16,"triangle"); setTimeout(()=>beep(880,0.18,"triangle"),90); }
  function sfxBad(){ beep(180,0.22,"sawtooth"); }
  function sfxTick(){ beep(880,0.06,"square"); }

  /* ---------- Narración (TTS) ---------- */
  function speak(text){
    if(!soundOn || !("speechSynthesis" in window)) return;
    try{
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(text);
      const voices = window.speechSynthesis.getVoices();
      const esVoice = voices.find(v=>/es-CO/i.test(v.lang)) || voices.find(v=>/^es/i.test(v.lang));
      if(esVoice) u.voice = esVoice;
      u.lang = "es-ES"; u.rate = 1.0; u.pitch = 1.0;
      window.speechSynthesis.speak(u);
    }catch(e){}
  }

  $("soundToggle").addEventListener("click", function(){
    soundOn = !soundOn;
    this.textContent = soundOn ? "🔊" : "🔇";
    if(!soundOn && "speechSynthesis" in window) window.speechSynthesis.cancel();
  });

  /* ---------- QR de acceso (generado localmente, sin conexión a internet) ---------- */
  (function initQR(){
    try{
      const url = window.location.href;
      if(/^https?:\/\//i.test(url) && typeof qrcode !== "undefined"){
        const qr = qrcode(0, "M");
        qr.addData(url);
        qr.make();
        $("qrbox").innerHTML = qr.createSvgTag({ cellSize:4.5, margin:3, scalable:true });
        const svg = $("qrbox").querySelector("svg");
        if(svg){ svg.style.width = "150px"; svg.style.height = "150px"; svg.style.display = "block"; }
        $("qrFallback").textContent = "";
      }else{
        $("qrFallback").textContent = "Sube este archivo a un enlace público (GitHub Pages / Netlify) para que el código QR se genere al proyectarlo en clase.";
      }
    }catch(e){
      $("qrFallback").textContent = "Sube este archivo a un enlace público (GitHub Pages / Netlify) para que el código QR se genere al proyectarlo en clase.";
    }
  })();

  /* ---------- Repaso ---------- */
  $("btnRepaso").addEventListener("click", function(){
    const panel = $("repasoPanel");
    panel.classList.toggle("open");
    this.textContent = panel.classList.contains("open") ? "Ocultar repaso" : "¿Necesitas repasar antes? (no cuenta el tiempo)";
  });

  /* ---------- Estado del juego ---------- */
  let deck = [];
  let idx = 0;
  let score = { que:0, como:0, paraque:0, familia:0 };
  let total = { que:0, como:0, paraque:0, familia:0 };
  let timeLeft = GAME_SECONDS;
  let timerInterval = null;
  let locked = false;
  const CIRC = 213.6; // 2*PI*34

  function startGame(){
    deck = shuffle(CARDS);
    idx = 0;
    score = { que:0, como:0, paraque:0, familia:0 };
    total = { que:0, como:0, paraque:0, familia:0 };
    timeLeft = GAME_SECONDS;
    locked = false;
    updateTimerDisplay();
    showScreen("screen-game");
    speak("Cinco minutos para recordar la Edad Antigua. Clasifica cada tarjeta según la ciudad que corresponde. ¡Comienza!");
    renderCard();
    clearInterval(timerInterval);
    timerInterval = setInterval(tick, 1000);
  }

  function tick(){
    timeLeft--;
    updateTimerDisplay();
    if(timeLeft <= 10 && timeLeft > 0) sfxTick();
    if(timeLeft <= 0){
      clearInterval(timerInterval);
      finishGame();
    }
  }

  function updateTimerDisplay(){
    const m = Math.floor(Math.max(timeLeft,0)/60);
    const s = Math.max(timeLeft,0) % 60;
    $("timerText").textContent = m + ":" + String(s).padStart(2,"0");
    const frac = Math.max(timeLeft,0) / GAME_SECONDS;
    $("timerBar").setAttribute("stroke-dashoffset", (CIRC * (1-frac)).toFixed(1));
    $("timerWrap").classList.toggle("low", timeLeft <= 30);
  }

  function renderCard(){
    if(idx >= deck.length){
      clearInterval(timerInterval);
      finishGame();
      return;
    }
    const c = deck[idx];
    $("dimTag").textContent = DIM_LABELS[c.dim];
    $("stmtText").textContent = c.text;
    $("cardCounter").textContent = "Tarjeta " + (idx+1) + " / " + deck.length;
    $("progressFill").style.width = ((idx)/deck.length*100).toFixed(1) + "%";
    $("stmtCard").classList.remove("flash-good","flash-bad");
    locked = false;
    document.querySelectorAll(".city-btn").forEach(b=>b.disabled=false);
  }

  document.querySelectorAll(".city-btn").forEach(btn=>{
    btn.addEventListener("click", function(){
      if(locked || idx >= deck.length) return;
      locked = true;
      document.querySelectorAll(".city-btn").forEach(b=>b.disabled=true);
      const c = deck[idx];
      const chosen = this.getAttribute("data-city");
      total[c.dim]++;
      const card = $("stmtCard");
      if(chosen === c.city){
        score[c.dim]++;
        card.classList.add("flash-good");
        sfxGood();
      }else{
        card.classList.add("flash-bad");
        sfxBad();
      }
      setTimeout(function(){
        idx++;
        if(timeLeft > 0) renderCard();
        else finishGame();
      }, 550);
    });
  });

  /* ---------- Resultados (inmediatos) ---------- */
  function finishGame(){
    clearInterval(timerInterval);
    const correct = score.que+score.como+score.paraque+score.familia;
    const answered = total.que+total.como+total.paraque+total.familia;
    const nota = Math.min(5, Math.max(1, 1 + (correct/CARDS.length)*4));
    const notaStr = nota.toFixed(1);

    showScreen("screen-results");
    $("scoreNum").textContent = notaStr;
    const frac = (nota-1)/4;
    $("scoreBar").setAttribute("stroke-dashoffset", (264*(1-frac)).toFixed(1));

    document.querySelectorAll("#breakdown .bd-row").forEach(row=>{
      const dim = row.getAttribute("data-dim");
      const pct = total[dim] ? (score[dim]/4*100) : 0;
      row.querySelector(".bd-val").textContent = score[dim] + "/4";
      row.querySelector(".bd-fill").style.width = pct.toFixed(0) + "%";
    });

    let msg;
    if(nota >= 4.5) msg = "¡Excelente! Dominas con claridad qué, cómo y para qué se educaba en la Antigüedad, y el papel de la familia en cada cultura.";
    else if(nota >= 4.0) msg = "Muy bien. Tienes clara la diferencia entre Esparta, Atenas y Roma. Repasa los detalles del rol familiar para afinar aún más.";
    else if(nota >= 3.0) msg = "Aprobado. Reconoces lo esencial, pero conviene repasar el papel de la familia y los métodos de cada cultura.";
    else msg = "Necesitas repasar. Vuelve a las fichas de repaso del portal antes de intentarlo de nuevo.";
    $("feedbackMsg").textContent = msg;

    const answeredNote = answered < CARDS.length ? " El tiempo se agotó antes de terminar todas las tarjetas." : "";
    speak("Tu resultado es " + notaStr.replace(".", " punto ") + " sobre cinco. " + msg + answeredNote);
  }

  $("btnStart").addEventListener("click", startGame);
  $("btnRetry").addEventListener("click", startGame);
  $("btnHome").addEventListener("click", function(){
    clearInterval(timerInterval);
    showScreen("screen-landing");
  });

  if("speechSynthesis" in window){ window.speechSynthesis.getVoices(); }
})();
</script>
</body>
</html>
