<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no">
<title>Portal del Tiempo · Edad Antigua de la Educación</title>
<style>
  :root{
    --void:#15130F;
    --void-2:#1E1B15;
    --parchment:#EFE3C8;
    --parchment-2:#E4D5B0;
    --ink:#241F17;
    --ink-soft:#4A4030;
    --bone:#FBF4E2;
    --gold:#C9A227;
    --gold-soft:#E4C96B;
    --clay:#A0472A;
    --clay-soft:#C25F3D;
    --esparta:#8C2F2F;
    --atenas:#2E6E6E;
    --roma:#4B3F72;
    --good:#4C7A3F;
    --bad:#A0392F;
    --radius:18px;
    --font-display:Cambria,'Palatino Linotype', Palatino, Georgia, 'Times New Roman', serif;
    --font-body:-apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --font-mono:ui-monospace, 'SFMono-Regular', 'Cascadia Mono', Consolas, 'Courier New', monospace;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(circle at 50% 0%, #2A2519 0%, var(--void) 55%, #0F0D0A 100%);
    color:var(--bone);
    font-family:var(--font-body);
    min-height:100vh;
    overflow-x:hidden;
  }
  .stars{
    position:fixed; inset:0; pointer-events:none; z-index:0; opacity:.5;
    background-image:
      radial-gradient(1.5px 1.5px at 20% 30%, rgba(228,201,107,.5) 50%, transparent 100%),
      radial-gradient(1.5px 1.5px at 70% 20%, rgba(228,201,107,.4) 50%, transparent 100%),
      radial-gradient(1px 1px at 85% 60%, rgba(228,201,107,.35) 50%, transparent 100%),
      radial-gradient(1.5px 1.5px at 35% 75%, rgba(228,201,107,.3) 50%, transparent 100%),
      radial-gradient(1px 1px at 55% 45%, rgba(228,201,107,.4) 50%, transparent 100%);
  }
  .screen{
    position:relative; z-index:1;
    max-width:640px; margin:0 auto;
    padding:32px 20px 56px;
    min-height:100vh;
    display:none;
    flex-direction:column;
    align-items:center;
  }
  .screen.active{display:flex;}
  #screen-game.active, #screen-results.active{ justify-content:center; }
  .eyebrow{
    font-family:var(--font-mono);
    letter-spacing:.18em; text-transform:uppercase;
    font-size:11px; color:var(--gold-soft); opacity:.85;
    margin:0 auto 10px; text-align:center;
    max-width:calc(100% - 56px);
  }
  h1{
    font-family:var(--font-display); font-weight:700;
    font-size:clamp(28px,7vw,42px); line-height:1.15;
    text-align:center; margin:0 0 8px; color:var(--bone);
    text-shadow:0 2px 18px rgba(201,162,39,.25);
  }
  .subtitle{
    text-align:center; color:var(--parchment-2); font-size:15.5px;
    max-width:480px; margin:0 auto 26px; line-height:1.55;
  }

  /* --- Portal ornament --- */
  .portal-wrap{ position:relative; width:190px; height:190px; margin:6px auto 22px; }
  .portal-ring{
    position:absolute; inset:0; border-radius:50%;
    border:1.5px solid rgba(201,162,39,.35);
  }
  .portal-ring.r2{ inset:14px; border-color:rgba(201,162,39,.55); animation:spin 40s linear infinite; }
  .portal-ring.r3{ inset:28px; border-color:rgba(228,201,107,.4); animation:spin 30s linear infinite reverse; border-style:dashed; }
  .portal-ring.r2::before, .portal-ring.r2::after{
    content:''; position:absolute; width:6px; height:6px; border-radius:50%; background:var(--gold-soft);
    top:-3px; left:calc(50% - 3px); box-shadow:0 0 8px var(--gold-soft);
  }
  .portal-ring.r2::after{ top:auto; bottom:-3px; }
  .portal-core{
    position:absolute; inset:52px; border-radius:50%;
    background:radial-gradient(circle at 40% 35%, #F3E6BE 0%, var(--gold) 45%, var(--clay) 100%);
    box-shadow:0 0 40px rgba(201,162,39,.55), inset 0 0 20px rgba(0,0,0,.25);
    display:flex; align-items:center; justify-content:center;
  }
  .portal-core svg{ width:42px; height:42px; }
  @keyframes spin{ to{ transform:rotate(360deg);} }

  /* --- Buttons --- */
  .btn{
    font-family:var(--font-body); font-weight:600; font-size:16px;
    border:none; border-radius:999px; cursor:pointer;
    padding:15px 30px; letter-spacing:.01em;
    transition:transform .15s ease, box-shadow .15s ease, opacity .15s ease;
  }
  .btn:active{ transform:scale(.97); }
  .btn-primary{
    background:linear-gradient(135deg, var(--clay-soft), var(--clay));
    color:var(--bone); box-shadow:0 8px 22px rgba(160,71,42,.4);
  }
  .btn-ghost{
    background:transparent; color:var(--gold-soft);
    border:1px solid rgba(228,201,107,.4); padding:12px 24px; font-size:14.5px;
  }
  .btn-block{ width:100%; }
  .btn-row{ display:flex; flex-direction:column; gap:12px; width:100%; max-width:360px; margin-top:6px;}

  /* --- QR box --- */
  .qr-card{
    background:var(--parchment); color:var(--ink); border-radius:var(--radius);
    padding:18px 20px 16px; text-align:center; margin:4px 0 24px;
    box-shadow:0 12px 30px rgba(0,0,0,.35);
    width:100%; max-width:270px;
  }
  .qr-card #qrbox{ display:flex; justify-content:center; margin:8px 0; }
  .qr-card #qrbox img, .qr-card #qrbox canvas{ border-radius:8px; }
  .qr-label{ font-family:var(--font-mono); font-size:11px; letter-spacing:.06em; color:var(--ink-soft); text-transform:uppercase; }
  .qr-fallback{ font-size:12px; color:var(--ink-soft); margin-top:6px; line-height:1.4; }

  /* --- Repaso accordion --- */
  .repaso-toggle{
    background:none; border:none; color:var(--gold-soft); font-family:var(--font-body);
    font-size:14px; text-decoration:underline; cursor:pointer; margin-top:4px; padding:6px;
  }
  .repaso-panel{
    display:none; width:100%; margin-top:14px;
  }
  .repaso-panel.open{ display:block; }
  .repaso-city{
    background:rgba(239,227,200,.06); border:1px solid rgba(201,162,39,.25);
    border-radius:14px; padding:14px 16px; margin-bottom:10px;
  }
  .repaso-city h3{ font-family:var(--font-display); font-size:16px; margin:0 0 8px; }
  .repaso-city dl{ margin:0; font-size:13.5px; color:var(--parchment-2); line-height:1.5;}
  .repaso-city dt{ font-weight:600; color:var(--gold-soft); display:inline; }
  .repaso-city dd{ margin:0 0 6px; display:inline;}
  .repaso-city dd::after{ content:''; display:block; }

  /* --- Challenge screen --- */
  .hud{ display:flex; align-items:center; justify-content:space-between; width:100%; margin-bottom:18px; gap:14px;}
  .timer-wrap{ position:relative; width:76px; height:76px; flex-shrink:0; }
  .timer-wrap svg{ width:100%; height:100%; transform:rotate(-90deg); }
  .timer-wrap .track{ fill:none; stroke:rgba(228,201,107,.15); stroke-width:6; }
  .timer-wrap .bar{ fill:none; stroke:var(--gold); stroke-width:6; stroke-linecap:round; transition:stroke-dashoffset 1s linear, stroke .3s; }
  .timer-wrap.low .bar{ stroke:var(--bad); }
  .timer-text{
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    font-family:var(--font-mono); font-size:16px; font-weight:600; color:var(--bone);
  }
  .progress-info{ flex:1; }
  .progress-label{ font-family:var(--font-mono); font-size:12px; color:var(--parchment-2); margin-bottom:6px; }
  .progress-track{ height:6px; background:rgba(228,201,107,.15); border-radius:4px; overflow:hidden; }
  .progress-fill{ height:100%; background:linear-gradient(90deg,var(--gold),var(--gold-soft)); width:0%; transition:width .3s ease; }

  .card-area{ width:100%; min-height:260px; display:flex; flex-direction:column; align-items:center; justify-content:center; }
  .stmt-card{
    background:var(--parchment); color:var(--ink); border-radius:var(--radius);
    padding:30px 24px; width:100%; max-width:420px; text-align:center;
    box-shadow:0 16px 34px rgba(0,0,0,.4);
    font-family:var(--font-body); font-size:18px; font-weight:500; line-height:1.45;
    position:relative; min-height:150px; display:flex; align-items:center; justify-content:center;
    transition:transform .18s ease, box-shadow .18s ease;
  }
  .stmt-card.flash-good{ box-shadow:0 0 0 4px var(--good), 0 16px 34px rgba(0,0,0,.4); }
  .stmt-card.flash-bad{ box-shadow:0 0 0 4px var(--bad), 0 16px 34px rgba(0,0,0,.4); }
  .dim-tag{
    position:absolute; top:-11px; left:50%; transform:translateX(-50%);
    background:var(--gold); color:var(--ink); font-family:var(--font-mono);
    font-size:10.5px; letter-spacing:.08em; text-transform:uppercase;
    padding:4px 12px; border-radius:999px; font-weight:600;
    box-shadow:0 3px 10px rgba(0,0,0,.35);
  }
  .city-choices{ display:flex; gap:10px; width:100%; max-width:420px; margin-top:24px; }
  .city-btn{
    flex:1; border:none; border-radius:14px; padding:16px 8px; cursor:pointer;
    font-family:var(--font-display); font-weight:600; font-size:14.5px; color:var(--bone);
    transition:transform .12s ease, filter .12s ease; box-shadow:0 8px 18px rgba(0,0,0,.35);
  }
  .city-btn:active{ transform:scale(.95); }
  .city-btn.esparta{ background:linear-gradient(135deg,#a63e3e,var(--esparta)); }
  .city-btn.atenas{ background:linear-gradient(135deg,#3c8b8b,var(--atenas)); }
  .city-btn.roma{ background:linear-gradient(135deg,#61548f,var(--roma)); }
  .city-btn:disabled{ opacity:.55; }

  /* --- Results --- */
  .score-ring{ position:relative; width:180px; height:180px; margin:8px auto 6px; }
  .score-ring svg{ width:100%; height:100%; transform:rotate(-90deg); }
  .score-ring .track{ fill:none; stroke:rgba(228,201,107,.15); stroke-width:10; }
  .score-ring .bar{ fill:none; stroke:url(#gradScore); stroke-width:10; stroke-linecap:round; }
  .score-text{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
  .score-num{ font-family:var(--font-display); font-size:44px; font-weight:700; color:var(--bone); line-height:1; }
  .score-den{ font-family:var(--font-mono); font-size:12px; color:var(--gold-soft); margin-top:2px; }
  .feedback-msg{
    text-align:center; font-size:16px; color:var(--parchment-2); max-width:420px;
    margin:6px auto 22px; line-height:1.5;
  }
  .breakdown{ width:100%; max-width:420px; margin-bottom:26px; }
  .bd-row{ margin-bottom:14px; }
  .bd-label{ display:flex; justify-content:space-between; font-size:13.5px; color:var(--bone); margin-bottom:5px; }
  .bd-label span:last-child{ font-family:var(--font-mono); color:var(--gold-soft); }
  .bd-track{ height:8px; background:rgba(228,201,107,.15); border-radius:5px; overflow:hidden; }
  .bd-fill{ height:100%; border-radius:5px; background:linear-gradient(90deg,var(--gold),var(--gold-soft)); }

  .sound-toggle{
    position:fixed; top:16px; right:16px; z-index:5;
    background:rgba(21,19,15,.6); border:1px solid rgba(228,201,107,.35);
    color:var(--gold-soft); border-radius:999px; width:42px; height:42px;
    font-size:18px; cursor:pointer; backdrop-filter:blur(6px);
  }
  footer.credit{
    margin-top:auto; padding-top:30px; text-align:center;
    font-family:var(--font-mono); font-size:10.5px; letter-spacing:.05em;
    color:rgba(228,201,107,.4);
  }
  @media (prefers-reduced-motion: reduce){
    .portal-ring.r2, .portal-ring.r3{ animation:none; }
  }
</style>
</head>
<body>
<div class="stars"></div>
<button class="sound-toggle" id="soundToggle" aria-label="Silenciar narración">🔊</button>

<!-- ============ PANTALLA 1: PORTAL / LANDING ============ -->
<section class="screen active" id="screen-landing">
  <div class="eyebrow">Universidad de Cartagena · Historia de la Educación</div>
  <h1>Portal del Tiempo</h1>
  <p class="subtitle">Edad Antigua de la educación (Siglos IX a.C. – V d.C.). Cruza el portal y demuestra en <strong>5 minutos</strong> qué, cómo y para qué se enseñaba en Esparta, Atenas y Roma — y qué papel jugaba la familia.</p>

  <div class="portal-wrap">
    <div class="portal-ring"></div>
    <div class="portal-ring r2"></div>
    <div class="portal-ring r3"></div>
    <div class="portal-core">
      <svg viewBox="0 0 24 24" fill="none"><path d="M12 2v3M12 19v3M4.2 4.2l2 2M17.8 17.8l2 2M2 12h3M19 12h3M4.2 19.8l2-2M17.8 6.2l2-2" stroke="#241F17" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="12" r="4.2" fill="#241F17"/></svg>
    </div>
  </div>

  <div class="qr-card">
    <div class="qr-label">Escanea para entrar desde tu celular</div>
    <div id="qrbox"></div>
    <div class="qr-fallback" id="qrFallback"></div>
  </div>

  <div class="btn-row">
    <button class="btn btn-primary btn-block" id="btnStart">Cruzar el portal — iniciar reto</button>
    <button class="repaso-toggle" id="btnRepaso">¿Necesitas repasar antes? (no cuenta el tiempo)</button>
  </div>

  <div class="repaso-panel" id="repasoPanel">
    <div class="repaso-city">
      <h3 style="color:var(--esparta)">Esparta — El Estado</h3>
      <dl>
        <dt>Qué:</dt> <dd>disciplina física, resistencia y obediencia.</dd>
        <dt>Cómo:</dt> <dd>agogé, entrenamiento estatal desde los 7 años.</dd>
        <dt>Para qué:</dt> <dd>formar guerreros al servicio del Estado.</dd>
        <dt>Familia:</dt> <dd>el niño pertenece primero a la ciudad, no a la casa.</dd>
      </dl>
    </div>
    <div class="repaso-city">
      <h3 style="color:var(--atenas)">Atenas — La Razón</h3>
      <dl>
        <dt>Qué:</dt> <dd>gramática, música, gimnasia y filosofía.</dd>
        <dt>Cómo:</dt> <dd>el paidagogos (esclavo tutor) acompaña al niño.</dd>
        <dt>Para qué:</dt> <dd>formar ciudadanos libres capaces de pensar.</dd>
        <dt>Familia:</dt> <dd>el padre elige y paga la educación del hijo.</dd>
      </dl>
    </div>
    <div class="repaso-city">
      <h3 style="color:var(--roma)">Roma — El Orador</h3>
      <dl>
        <dt>Qué:</dt> <dd>retórica, oratoria y derecho.</dd>
        <dt>Cómo:</dt> <dd>imitación de grandes oradores, práctica pública.</dd>
        <dt>Para qué:</dt> <dd>formar oradores para el foro y el cursus honorum.</dd>
        <dt>Familia:</dt> <dd>el paterfamilias tiene autoridad absoluta; la casa es la primera escuela.</dd>
      </dl>
    </div>
  </div>
  <footer class="credit">FILOSOFÍA · ANTROPOLOGÍA · HISTORIA DE LA EDUCACIÓN</footer>
</section>

<!-- ============ PANTALLA 2: RETO ============ -->
<section class="screen" id="screen-game">
  <div class="hud">
    <div class="timer-wrap" id="timerWrap">
      <svg viewBox="0 0 80 80">
        <circle class="track" cx="40" cy="40" r="34"></circle>
        <circle class="bar" id="timerBar" cx="40" cy="40" r="34" stroke-dasharray="213.6" stroke-dashoffset="0"></circle>
      </svg>
      <div class="timer-text" id="timerText">5:00</div>
    </div>
    <div class="progress-info">
      <div class="progress-label" id="cardCounter">Tarjeta 1 / 16</div>
      <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
    </div>
  </div>

  <div class="card-area">
    <div class="stmt-card" id="stmtCard">
      <span class="dim-tag" id="dimTag">Qué</span>
      <span id="stmtText">Texto de la tarjeta</span>
    </div>
    <div class="city-choices">
      <button class="city-btn esparta" data-city="esparta">ESPARTA</button>
      <button class="city-btn atenas" data-city="atenas">ATENAS</button>
      <button class="city-btn roma" data-city="roma">ROMA</button>
    </div>
  </div>
</section>

<!-- ============ PANTALLA 3: RESULTADOS ============ -->
<section class="screen" id="screen-results">
  <div class="eyebrow">Resultado del reto</div>
  <h1 style="font-size:26px;">Tu paso por la Edad Antigua</h1>

  <div class="score-ring">
    <svg viewBox="0 0 100 100">
      <defs>
        <linearGradient id="gradScore" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#C9A227"/>
          <stop offset="100%" stop-color="#E4C96B"/>
        </linearGradient>
      </defs>
      <circle class="track" cx="50" cy="50" r="42"></circle>
      <circle class="bar" id="scoreBar" cx="50" cy="50" r="42" stroke-dasharray="264" stroke-dashoffset="264"></circle>
    </svg>
    <div class="score-text">
      <div class="score-num" id="scoreNum">0.0</div>
      <div class="score-den">/ 5.0</div>
    </div>
  </div>
  <p class="feedback-msg" id="feedbackMsg">Cargando resultado...</p>

  <div class="breakdown" id="breakdown">
    <div class="bd-row" data-dim="que">
      <div class="bd-label"><span>Qué se enseñaba</span><span class="bd-val">0/4</span></div>
      <div class="bd-track"><div class="bd-fill" style="width:0%"></div></div>
    </div>
    <div class="bd-row" data-dim="como">
      <div class="bd-label"><span>Cómo se enseñaba</span><span class="bd-val">0/4</span></div>
      <div class="bd-track"><div class="bd-fill" style="width:0%"></div></div>
    </div>
    <div class="bd-row" data-dim="paraque">
      <div class="bd-label"><span>Para qué se enseñaba</span><span class="bd-val">0/4</span></div>
      <div class="bd-track"><div class="bd-fill" style="width:0%"></div></div>
    </div>
    <div class="bd-row" data-dim="familia">
      <div class="bd-label"><span>Papel de la familia</span><span class="bd-val">0/4</span></div>
      <div class="bd-track"><div class="bd-fill" style="width:0%"></div></div>
    </div>
  </div>

  <div class="btn-row">
    <button class="btn btn-primary btn-block" id="btnRetry">Intentar de nuevo</button>
    <button class="btn btn-ghost btn-block" id="btnHome">Volver al portal</button>
  </div>
</section>

<script>
